project_name = "fiapgames"
environment  = "dev"
location     = "brazilsouth"

container_image             = "ghcr.io/your-org/fiap-games:latest"
container_registry_server   = "ghcr.io"
container_registry_username = "your-github-username"
container_registry_password = "your-github-pat-with-read-packages-scope"

jwt_secret = "replace-with-a-long-random-string"
